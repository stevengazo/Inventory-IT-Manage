@inject PDFService pdfService
@inject IJSRuntime JS
@inject IHttpContextAccessor httpContextAccessor

<h3>Extensiones Registradas</h3>

<div class="d-flex flex-column justify-content-between p-2">

    <p>
        Esta tabla muestra la información sobre la asignación, la extensión y el PBX utilizado.
    </p>

    <div class="d-flex flex-row justify-content-between gap-2">

        <button @onclick="DownloadPDF"
                class="btn btn-outline-warning btn-sm">
            Descargar
        </button>

        <input type="text"
               class="form-control w-25"
               placeholder="Buscar por extensión, PBX o persona..."
               @bind="searchText"
               @bind:event="oninput" />
    </div>

</div>

<div class="overflow-auto table-responsive">
    <div class="shadow-sm rounded-4 border table-responsive">

        <table class="table table-sm table-hover align-middle mb-0">

            <thead class="table-light text-nowrap sticky-top small text-uppercase">
                <tr>
                    <th>Nombre</th>
                    <th>PBX</th>

                    @if (!infoisPublic)
                    {
                        <th>Usuario</th>
                        <th>Contraseña</th>
                    }

                    <th>Extensión</th>
                    <th>Empleado</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>

            <tbody>
                @if (FilteredData.Any())
                {
                    foreach (PhoneExtension item in FilteredData)
                    {
                        <tr>

                            <td class="fw-semibold text-capitalize">
                                @item.PhoneExtensionName
                            </td>

                            <td class="small text-muted">
                                @item.PhoneNumberPBX
                            </td>

                            @if (!infoisPublic)
                            {
                                <td class="font-monospace small">
                                    @item.UserNumber
                                </td>

                                <td class="font-monospace small text-muted">
                                    ••••••••
                                </td>
                            }

                            <td class="font-monospace fw-bold text-primary">
                                @item.Extension
                            </td>

                            @if (item.Employee != null && !item.Employee.Fired)
                            {
                                <td class="text-nowrap">
                                    @item.Employee.Name @item.Employee.LastName
                                </td>
                            }
                            else if (item.Employee != null && item.Employee.Fired)
                            {
                                <td class="text-muted">
                                    <span class="badge bg-danger-subtle text-dark">
                                        @item.Employee.Name @item.Employee.LastName
                                    </span>
                                </td>
                            }
                            else
                            {
                                <td>
                                    <span class="badge bg-info-subtle text-dark">
                                        Sin asignar
                                    </span>
                                </td>
                            }

                            <AuthorizeView Roles="Administrador">
                                <Authorized>
                                    <td class="text-center">
                                        <div class="d-inline-flex gap-1">

                                            <a href="/extensions/@item.PhoneExtensionId"
                                               class="btn btn-sm btn-outline-info">
                                                <span class="oi oi-eye"></span>
                                            </a>

                                            <a href="/extension/assign/@item.PhoneExtensionId"
                                               class="btn btn-sm btn-outline-success">
                                                <span class="oi oi-person"></span>
                                            </a>

                                            <a href="/extension/edit/@item.PhoneExtensionId"
                                               class="btn btn-sm btn-outline-primary">
                                                <span class="oi oi-pencil"></span>
                                            </a>

                                        </div>
                                    </td>
                                </Authorized>

                                <NotAuthorized>
                                    <td class="text-center small text-warning">
                                        No disponible
                                    </td>
                                </NotAuthorized>
                            </AuthorizeView>

                        </tr>
                    }
                }
            </tbody>

        </table>

    </div>
</div>

@code {

    [Parameter]
    public List<PhoneExtension> Extensions { get; set; } = new();

    [Parameter]
    public bool PublicInfo { get; set; }

    private string searchText = "";
    private bool infoisPublic = false;

    protected override void OnInitialized()
    {
        infoisPublic = PublicInfo;
    }

    private IEnumerable<PhoneExtension> FilteredData
    {
        get
        {
            if (Extensions == null)
                return Enumerable.Empty<PhoneExtension>();

            if (string.IsNullOrWhiteSpace(searchText))
                return Extensions;

            var term = searchText.Trim();

            return Extensions.Where(x =>

                (x.Extension != null &&
                 x.Extension.ToString().Contains(term, StringComparison.OrdinalIgnoreCase))

                ||

                (x.PhoneNumberPBX != null &&
                 x.PhoneNumberPBX.ToString().Contains(term, StringComparison.OrdinalIgnoreCase))

                ||

                (!string.IsNullOrEmpty(x.UserNumber) &&
                 x.UserNumber.Contains(term, StringComparison.OrdinalIgnoreCase))

                ||

                (x.Employee != null &&
                 (
                    (!string.IsNullOrEmpty(x.Employee.Name) &&
                     x.Employee.Name.Contains(term, StringComparison.OrdinalIgnoreCase))

                    ||

                    (!string.IsNullOrEmpty(x.Employee.LastName) &&
                     x.Employee.LastName.Contains(term, StringComparison.OrdinalIgnoreCase))
                 ))
            );
        }
    }

    private async Task DownloadPDF()
    {
        byte[] pdfBytes = await pdfService.GenerateListExtensions(FilteredData.ToList());

        string pdfBase64 = Convert.ToBase64String(pdfBytes);

        await JS.InvokeVoidAsync("downloadPDF",
            pdfBase64,
            $"Extensiones {DateTime.Today:yyyy-MMM-dd}.pdf");
    }
}