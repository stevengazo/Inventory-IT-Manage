<div class="row mb-2 my-3">

    <div class="col-md-6">
        <input type="text" class="form-control"
               placeholder="Buscar número, operador o tipo..."
               @bind="searchText"
               @bind:event="oninput" />
    </div>

    <div class="col-md-3">
        ¿No encuentras algún activo? Revisa
        <a href="phone-number-disable" class="text-danger">
            Cuentas Desactivadas
        </a>
    </div>

</div>

<div class="table-responsive mx-auto">
    <table class="table table-sm table-hover align-middle mb-0">

        <thead class="table-light text-nowrap sticky-top">
            <tr class="small text-uppercase">

                @if (ShowId)
                {
                    <th role="button"
                        @onclick="() => SortBy(nameof(PhoneNumber.PhoneNumberId))">
                        Id
                    </th>
                }

                <th role="button"
                    @onclick="() => SortBy(nameof(PhoneNumber.Number))">
                    Número
                </th>

                <th role="button"
                    @onclick="() => SortBy(nameof(PhoneNumber.Operator))">
                    Operador
                </th>

                <th role="button"
                    @onclick="() => SortBy(nameof(PhoneNumber.Type))">
                    Tipo
                </th>

                <th role="button"
                    @onclick="() => SortBy(nameof(PhoneNumber.Cost))">
                    Costo
                </th>

                <th role="button"
                    @onclick="() => SortBy(nameof(PhoneNumber.ExpireDate))">
                    Vencimiento
                </th>

                <th class="text-center">
                    Acciones
                </th>

            </tr>
        </thead>

        <tbody>
            @foreach (PhoneNumber i in FilteredData)
            {
                <tr class="border-top">

                    @if (ShowId)
                    {
                        <td class="font-monospace small text-secondary">
                            @i.PhoneNumberId
                        </td>
                    }

                    <td class="fw-semibold text-nowrap">
                        @i.Number
                    </td>

                    <td>
                        <span class="badge bg-primary-subtle text-dark">
                            @i.Operator
                        </span>
                    </td>

                    <td>
                        <span class="badge bg-info-subtle text-dark">
                            @i.Type
                        </span>
                    </td>

                    <td class="text-muted">
                        @(i.Cost != 0 && i.Cost != 1
                                            ? $"$ {i.Cost}"
                                            : "$ No indicado")
                    </td>

                    <td class="small text-muted">
                        @i.ExpireDate.ToShortDateString()
                    </td>

                    <AuthorizeView Roles="Administrador">
                        <Authorized>
                            <td class="text-center">
                                <div class="d-inline-flex gap-1">

                                    <a href="/phones-numbers/@i.PhoneNumberId"
                                       class="btn btn-sm btn-outline-info">
                                        <span class="oi oi-pencil"></span>
                                    </a>

                                </div>
                            </td>
                        </Authorized>

                        <NotAuthorized>
                            <td class="text-center small text-warning">
                                No disponible
                            </td>
                        </NotAuthorized>
                    </AuthorizeView>

                </tr>
            }
        </tbody>

    </table>
        </div>



@code {

    [Parameter]
    public List<PhoneNumber> PhoneNumbers { get; set; } = new();
    [Parameter]
    public bool ShowId { get; set; } = false;

    private string searchText;

    private string currentSortColumn = nameof(PhoneNumber.Number);
    private bool asc = true;

    private IEnumerable<PhoneNumber> FilteredData =>
        ApplySorting(
            PhoneNumbers
            .Where(x =>
                string.IsNullOrWhiteSpace(searchText) ||

                x.Number.ToString().Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                (x.Operator != null && x.Operator.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                (x.Type != null && x.Type.Contains(searchText, StringComparison.OrdinalIgnoreCase))
            )
        );

    void SortBy(string column)
    {
        if (currentSortColumn == column)
            asc = !asc;
        else
        {
            currentSortColumn = column;
            asc = true;
        }
    }

    IEnumerable<PhoneNumber> ApplySorting(IEnumerable<PhoneNumber> query)
    {
        return currentSortColumn switch
        {
            nameof(PhoneNumber.Number) =>
                asc ? query.OrderBy(x => x.Number)
                    : query.OrderByDescending(x => x.Number),

            nameof(PhoneNumber.Operator) =>
                asc ? query.OrderBy(x => x.Operator)
                    : query.OrderByDescending(x => x.Operator),

            nameof(PhoneNumber.Type) =>
                asc ? query.OrderBy(x => x.Type)
                    : query.OrderByDescending(x => x.Type),

            nameof(PhoneNumber.Cost) =>
                asc ? query.OrderBy(x => x.Cost)
                    : query.OrderByDescending(x => x.Cost),

            nameof(PhoneNumber.ExpireDate) =>
                asc ? query.OrderBy(x => x.ExpireDate)
                    : query.OrderByDescending(x => x.ExpireDate),

            _ => query
        };
    }

}