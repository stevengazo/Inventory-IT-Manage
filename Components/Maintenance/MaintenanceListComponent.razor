@inject IControllerServices<Maintenance> _maintenanceService;


<div class="container my-4">
    <h4 class="mb-3">Lista de Auditorías</h4>
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Fecha</th>
                <th>Tecnico</th>
                <th>Tipo</th>
                <th>Costo</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var i in maintenances)
            {
                <tr>
                    <td>@i.MaintenanceDate.ToString("dd MMM yyyy")</td>
                    <td>@i.TechnicianName</td>
                    <td>@i.MaintenanceType</td>
                    <td>@i.Cost </td>
                </tr>
            }
        </tbody>
    </table>
</div>


@code {
		[Parameter]
		public int DeviceId { get; set; } = 0;
		[Parameter]
		public DeviceType Type { get; set; }

		List<Maintenance> maintenances = new();

	protected override async Task OnInitializedAsync()
	{
		switch (Type)
		{
			case DeviceType.Computer:
				maintenances = _maintenanceService.Search(a => a.ComputerModelID == DeviceId);
				break;
			case DeviceType.Peripheric:
				maintenances = _maintenanceService.Search(a => a.PeripheralModelId == DeviceId);
				break;
			case DeviceType.Phone:
				maintenances = _maintenanceService.Search(a => a.SmartPhoneModelId == DeviceId);
				break;
			default:
				break;
		}
	}
}