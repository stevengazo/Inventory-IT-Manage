@using InventoryIT.Data

<h3>Empleados Registrados</h3>

<div class="shadow p-2 rounded my-2">
    <input type="text"
           class="form-control"
           placeholder="Buscar por cédula, nombre, departamento, correo o teléfono..."
           @bind="searchTerm"
           @bind:event="oninput" />
</div>

<div class="shadow p-2 rounded table-responsive">
    <div class="shadow-sm rounded-4 border table-responsive">

        <table class="table table-sm table-hover align-middle mb-0">

            <thead class="table-light text-nowrap sticky-top small text-uppercase">
                <tr>
                    <th role="button" @onclick="() => SortBy(nameof(Employee.DNI))">
                        Cédula
                    </th>

                    <th role="button" @onclick="() => SortBy(nameof(Employee.Name))">
                        Nombre
                    </th>

                    <th role="button" @onclick="() => SortBy(nameof(Employee.DepartamentID))">
                        Departamento
                    </th>

                    <th role="button" @onclick="() => SortBy(nameof(Employee.Email))">
                        Correo
                    </th>

                    <th role="button" @onclick="() => SortBy(nameof(Employee.PhoneNumber))">
                        Teléfono
                    </th>

                    <th class="text-center">
                        Acciones
                    </th>
                </tr>
            </thead>

            <tbody>
                @if (Employees != null)
                {
                    foreach (Employee item in FilteredData)
                    {
                        <tr class="@(item.Fired ? "table-danger text-muted" : "")">

                            <td class="font-monospace small text-secondary">
                                @item.DNI
                            </td>

                            <td class="fw-semibold text-capitalize text-nowrap">
                                @item.Name @item.LastName @item.SecondLastName
                            </td>

                            <td>
                                <span class="badge bg-info-subtle text-dark">
                                    @item.Departament?.Name
                                </span>
                            </td>

                            <td class="small text-muted">
                                @item.Email
                            </td>

                            <td class="text-nowrap">
                                @item.PhoneNumber
                            </td>

                            <AuthorizeView Roles="Administrador,lector">
                                <Authorized>
                                    <td class="text-center">
                                        <div class="d-inline-flex gap-1">

                                            <a href="/employee/@item.EmployeeId"
                                               class="btn btn-sm btn-outline-success">
                                                <span class="oi oi-eye"></span>
                                            </a>

                                            <a href="/employee/edit/@item.EmployeeId"
                                               class="btn btn-sm btn-outline-info">
                                                <span class="oi oi-pencil"></span>
                                            </a>

                                        </div>
                                    </td>
                                </Authorized>

                                <NotAuthorized>
                                    <td></td>
                                </NotAuthorized>
                            </AuthorizeView>

                        </tr>
                    }
                }
            </tbody>

        </table>

    </div>
</div>

@code {

    [Parameter]
    public List<Employee> Employees { get; set; } = new();

    private string searchTerm = "";

    private string currentSortColumn = nameof(Employee.DNI);
    private bool asc = true;

    private IEnumerable<Employee> FilteredData =>
        ApplySorting(
            Employees.Where(e =>
            {
                if (string.IsNullOrWhiteSpace(searchTerm))
                    return true;

                var term = searchTerm.ToLower();

                return
                    e.DNI.ToString().Contains(term) ||
                    e.Name?.ToLower().Contains(term) == true ||
                    e.LastName?.ToLower().Contains(term) == true ||
                    e.SecondLastName?.ToLower().Contains(term) == true ||
                    e.Departament?.Name?.ToLower().Contains(term) == true ||
                    e.Email?.ToLower().Contains(term) == true ||
                    e.PhoneNumber.ToString()?.ToLower().Contains(term) == true;
            })
        );

    void SortBy(string column)
    {
        if (currentSortColumn == column)
            asc = !asc;
        else
        {
            currentSortColumn = column;
            asc = true;
        }
    }

    IEnumerable<Employee> ApplySorting(IEnumerable<Employee> query)
    {
        return currentSortColumn switch
        {
            nameof(Employee.DNI) =>
                asc ? query.OrderBy(x => x.DNI)
                    : query.OrderByDescending(x => x.DNI),

            nameof(Employee.Name) =>
                asc ? query.OrderBy(x => x.Name)
                    : query.OrderByDescending(x => x.Name),

            nameof(Employee.DepartamentID) =>
                asc ? query.OrderBy(x => x.Departament.Name)
                    : query.OrderByDescending(x => x.Departament.Name),

            nameof(Employee.Email) =>
                asc ? query.OrderBy(x => x.Email)
                    : query.OrderByDescending(x => x.Email),

            nameof(Employee.PhoneNumber) =>
                asc ? query.OrderBy(x => x.PhoneNumber)
                    : query.OrderByDescending(x => x.PhoneNumber),

            _ => query
        };
    }

}