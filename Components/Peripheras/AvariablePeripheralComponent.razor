@inject IControllerServices<PeripheralModel> _PeriService;

<div>
    <h4 class="text-center">Perifericos Disponibles</h4>

    <div class="d-flex flex-wrap gap-2 justify-content-center">
        @foreach (var i in PeripheralList)
        {
            <div class="border rounded p-3 d-flex flex-column flex-md-row w-100 bg-light align-items-center gap-3">
                <div class="d-flex flex-column flex-md-row gap-2 w-100 align-items-center">
                    <span class="fw-bold">Modelo:</span>
                    <h6 class="mb-0">@i.Model</h6>
                </div>
                <div class="d-flex flex-column flex-md-row gap-2 w-100 align-items-center">
                    <span class="fw-bold">Procesador:</span>
                    <p class="mb-0">@i.SerialNumber</p>
                </div>
                <div class="d-flex flex-column flex-md-row gap-2 w-100 align-items-center">
                    <span class="fw-bold">RAM:</span>
                    <p class="mb-0">@i.Brand.Name</p>
                </div>
                <div class="d-flex justify-content-center w-100">
                    <a href="/peripherals/@i.PeripheralModelId" class="bg-secondary rounded p-2 text-white text-decoration-none">
                        <span class="oi oi-eye" aria-hidden="true"></span> Ver más
                    </a>
                </div>
            </div>
        }
    </div>
</div>

<div class="mt-4">
    <h4 class="text-center text-danger">Perifericos Desactivadas</h4>

    <div class="d-flex flex-wrap gap-2 justify-content-center">
        @foreach (var i in PeripheralDisable)
        {
            <div class="border rounded p-3 d-flex flex-column flex-md-row w-100 bg-light align-items-center gap-3">
                <div class="d-flex flex-column flex-md-row gap-2 w-100 align-items-center">
                    <span class="fw-bold">Modelo:</span>
                    <h6 class="mb-0">@i.Model</h6>
                </div>
                <div class="d-flex flex-column flex-md-row gap-2 w-100 align-items-center">
                    <span class="fw-bold">Procesador:</span>
                    <p class="mb-0">@i.SerialNumber</p>
                </div>
                <div class="d-flex flex-column flex-md-row gap-2 w-100 align-items-center">
                    <span class="fw-bold">RAM:</span>
                    <p class="mb-0">@i.Brand.Name</p>
                </div>
                <div class="d-flex justify-content-center w-100">
                    <a href="/peripherals/@i.PeripheralModelId" class="bg-secondary rounded p-2 text-white text-decoration-none">
                        <span class="oi oi-eye" aria-hidden="true"></span> Ver más
                    </a>
                </div>
            </div>
        }
    </div>
</div>


@code {
    List<PeripheralModel> PeripheralList = new();
    List<PeripheralModel> PeripheralDisable = new();

    protected override async Task OnInitializedAsync()
    {
        PeripheralList = _PeriService.GetAll()
            .Where(i => i.EmployeeId == null && i.IsActive)
            .OrderBy(i => i.Model)
            .ToList();

        PeripheralDisable = _PeriService.GetAll()
            .Where(i => i.EmployeeId == null && !i.IsActive)
            .OrderBy(i => i.Model)
            .ToList();

        await base.OnInitializedAsync();
    }
}
