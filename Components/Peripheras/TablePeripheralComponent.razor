@inject PDFService pdfService
@inject IJSRuntime JS
@inject IHttpContextAccessor httpContextAccessor




<div class="shadow p-2 rounded">
    <div class="d-flex flex-row justify-content-between p-2">
        <h3 class="w-100">Dispositivos Existentes</h3>
        <input type="text" placeholder="Búsqueda" @onchange="@(e => Search(((ChangeEventArgs)e).Value.ToString()))" class="form-control w-25" />
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Nombre</th>
                    <th>Marca</th>
                    <th>Tipo</th>
                    <th>Modelo</th>
                    <th>Numero Serie</th>
                    <th>Fecha Adquisición</th>
                    <th>Costo</th>
                    <th>Empleado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>

            <tbody>
                @if (Peripheralstmp != null && Peripheralstmp.Any())
                {
                    @foreach (var C in Peripheralstmp)
                    {
                        <tr>
                            <td>@C.Name</td>
                            <td>@C.Brand?.Name</td>
                            <td>@C.Type</td>
                            <td>@C.Model</td>
                            <td>@C.SerialNumber</td>
                            <td>@C.AdquisitionDate.ToShortDateString()</td>
                            <td>$@C.Cost</td>

                            @if (C.Employee != null && !C.Employee.Fired)
                            {
                                <td>
                                    <span class="badge bg-success-subtle text-dark">
                                        @C.Employee.Name @C.Employee.LastName
                                    </span>
                                </td>
                            }
                            else if (C.Employee != null && C.Employee.Fired)
                            {
                                <td>
                                    <span class="badge bg-danger">
                                        @C.Employee.Name @C.Employee.LastName (Despedido)
                                    </span>
                                </td>
                            }
                            else
                            {
                                <td>
                                    <span class="badge bg-secondary">
                                        Sin Asignar
                                    </span>
                                </td>
                            }

                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2">

                                    @if (C.Employee != null)
                                    {
                                        <button @onclick="() => DownloadPDF(C)"
                                                class="btn btn-sm btn-warning rounded-3 shadow-sm">
                                            <span class="oi oi-document text-white"></span>
                                        </button>
                                    }
                                

                                    <AuthorizeView Roles="Administrador">
                                        <Authorized>

                                            <a href="/peripherals/@C.PeripheralModelId"
                                               class="btn btn-sm btn-info rounded-3 shadow-sm">
                                                <span class="oi oi-eye text-white"></span>
                                            </a>

                                            <a href="/peripherals/edit/@C.PeripheralModelId"
                                               class="btn btn-sm btn-success rounded-3 shadow-sm">
                                                <span class="oi oi-pencil text-white"></span>
                                            </a>

                                        </Authorized>
                                    </AuthorizeView>

                                </div>
                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center text-muted py-4">
                            No hay periféricos registrados
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </div>
</div>

@code {
    [Parameter]
    public List<PeripheralModel> Peripherals { get; set; }
    List<PeripheralModel> Peripheralstmp = new();
    protected override void OnParametersSet()
    {
        Peripheralstmp = Peripherals;
        base.OnParametersSet();
    }

    private void Search(string SearchValue = "")
    {
        if (!string.IsNullOrEmpty(SearchValue))
        {
            Peripheralstmp = (from i in Peripherals
                             where i.SerialNumber.ToLower().Contains(SearchValue.ToLower()) 
                             || i.Model.ToLower().Contains(SearchValue.ToLower())
                              || i.Type.ToLower().Contains(SearchValue.ToLower())
                             select i)
                .ToList();
        }
        else
        {
            Peripheralstmp = Peripherals;
        }

    }



    private async Task DownloadPDF(PeripheralModel e)
    {
        try
        {
            byte[] pdfBytes = await pdfService.GeneratePDFPeripheral(e);


            // Convertir los bytes del PDF a una cadena base64 para pasarlos a JavaScript
            string pdfBase64 = Convert.ToBase64String(pdfBytes);

            // Invocar una función JavaScript para iniciar la descarga del PDF
            await JS.InvokeVoidAsync("downloadPDF", pdfBase64, $"Entrega Activo {e.Employee.Name} {e.Employee.LastName} {DateTime.Now.ToShortTimeString()}.pdf");
        }
        catch (Exception ec)
        {
            throw;
        }
    }
}
