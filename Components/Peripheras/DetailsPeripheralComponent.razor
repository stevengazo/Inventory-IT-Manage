<div class="card shadow-sm border-0 rounded-3 my-3">
    <div class="card-body">

        <div class="row g-3">

            <div class="col-md-6">
                <small class="text-muted">Marca</small>
                <div class="fw-semibold">@peripheral.Brand?.Name</div>
            </div>

            <div class="col-md-6">
                <small class="text-muted">@nameof(peripheral.Name)</small>
                <div class="fw-semibold">@peripheral.Name</div>
            </div>

            <div class="col-md-6">
                <small class="text-muted">Tipo</small>
                <div class="fw-semibold">@peripheral.Type</div>
            </div>

            <div class="col-md-6">
                <small class="text-muted">Número de Serie</small>
                <div class="fw-semibold">@peripheral.SerialNumber</div>
            </div>

            <div class="col-md-6">
                <small class="text-muted">Modelo</small>
                <div class="fw-semibold">@peripheral.Model</div>
            </div>

            <div class="col-md-6">
                <small class="text-muted">Fecha Adquisición</small>
                <div class="fw-semibold">
                    @peripheral.AdquisitionDate.ToLongDateString()
                </div>
            </div>

            <div class="col-md-6">
                <small class="text-muted">Costo</small>
                <div class="fw-semibold">
                    @peripheral.Cost.ToString("C")
                </div>
            </div>

            <div class="col-md-6">
                <small class="text-muted">Empleado</small>
                <div class="fw-semibold">
                    @(peripheral.Employee != null
                                        ? $"{peripheral.Employee.Name} {peripheral.Employee.LastName}"
                                        : "Sin Asignar")
                </div>
            </div>

        </div>

    </div>
</div>

@code {
    [Parameter]
    public PeripheralModel peripheral { get; set; }
}