@using ClosedXML.Excel
@inject PDFService pdfService
@inject IJSRuntime JS
@inject IHttpContextAccessor httpContextAccessor

<div class="shadow p-2 rounded my-2 justify-content-between d-flex gap-2 flex flex-row ">

    <input type="text" class="form-control"
           placeholder="Buscar número, modelo, serie, marca, operador o encargado..."
           @bind="searchTerm"
           @bind:event="oninput" />
    <button class="btn btn-success mx-3 w-25" @onclick="DownloadXLSX">
        Descargar XLSX
    </button>

</div>

<div class="shadow-sm rounded-4 border table-responsive">

    <table class="table table-sm table-hover align-middle mb-0">

        <thead class="table-light text-nowrap sticky-top">
            <tr class="small text-uppercase">

                <th role="button" @onclick="() => SortBy(nameof(Phone_Number_User_Model.PhoneNumberModel.Brand))">
                    Marca
                </th>

                <th role="button" @onclick="() => SortBy(nameof(Phone_Number_User_Model.PhoneNumberModel.PhoneModel))">
                    Modelo
                </th>

                <th role="button" @onclick="() => SortBy(nameof(Phone_Number_User_Model.PhoneNumberModel.PhoneSerial))">
                    Serie
                </th>

                <th role="button" @onclick="() => SortBy(nameof(Phone_Number_User_Model.PhoneNumber.Number))">
                    Número
                </th>

                <th role="button" @onclick="() => SortBy(nameof(Phone_Number_User_Model.PhoneNumber.Operator))">
                    Operador
                </th>

                <th role="button" @onclick="() => SortBy(nameof(Phone_Number_User_Model.PhoneNumber.Type))">
                    Tipo
                </th>

                <th>
                    Encargado
                </th>

                <th role="button" @onclick="() => SortBy(nameof(Phone_Number_User_Model.CreationDate))">
                    Registro
                </th>

                <th class="text-center">
                    Acciones
                </th>

            </tr>
        </thead>

        <tbody>
            @foreach (var item in FilteredData.Where(x => x.IsActive))
            {
                <tr class="border-top">

                    <td class="fw-semibold text-nowrap">
                        @item.PhoneNumberModel.Brand.Name
                    </td>

                    <td class="text-muted text-nowrap">
                        @item.PhoneNumberModel.PhoneModel
                    </td>

                    <td class="font-monospace small text-secondary">
                        @item.PhoneNumberModel.PhoneSerial
                    </td>

                    <td class="fw-semibold text-nowrap">
                        @item.PhoneNumber.Number
                    </td>

                    <td>
                        <span class="badge bg-primary-subtle text-dark">
                            @item.PhoneNumber.Operator
                        </span>
                    </td>

                    <td>
                        <span class="badge bg-info-subtle text-dark">
                            @item.PhoneNumber.Type
                        </span>
                    </td>

                    <td class="text-capitalize">
                        <a href="/employee/@item.EmployeeId"
                           class="badge bg-primary text-white
                  text-decoration-none fw-semibold
                  d-inline-flex align-items-center gap-2 px-3 py-2 rounded-pill
                  employee-badge">

                            <i class="bi bi-person-fill"></i>

                            @($"{item.Employee.Name} {item.Employee.LastName}")

                        </a>
                    </td>

                    <td class="small text-muted">
                        @item.CreationDate.ToShortDateString()
                    </td>

                    <td class="text-center">
                        <div class="d-inline-flex gap-1">

                            <button @onclick="() => DownloadPDF(item)"
                                    class="btn btn-sm btn-outline-warning">
                                <span class="oi oi-document"></span>
                            </button>

                            <AuthorizeView Roles="Administrador">
                                <Authorized>

                                    <a href="/phone-number-user/@item.Id"
                                       class="btn btn-sm btn-outline-danger">
                                        <span class="oi oi-delete"></span>
                                    </a>

                                    <a href="/smartphone/@item.SmartPhoneModelId"
                                       class="btn btn-sm btn-outline-info">
                                        <span class="oi oi-data-transfer-upload"></span>
                                    </a>

                                </Authorized>
                            </AuthorizeView>

                        </div>
                    </td>

                </tr>
            }
        </tbody>

    </table>

</div>



@code {

    [Parameter]
    public List<Phone_Number_User_Model> phone_Number_User_Models { get; set; } = new();

    private string searchTerm = "";

    private string currentSortColumn = nameof(Phone_Number_User_Model.CreationDate);
    private bool asc = true;

    private IEnumerable<Phone_Number_User_Model> FilteredData =>
        ApplySorting(
            phone_Number_User_Models.Where(item =>
            {
                if (string.IsNullOrWhiteSpace(searchTerm))
                    return true;

                var term = searchTerm.Trim().ToLower();

                bool isNumber = int.TryParse(term, out var number);

                return
                    (isNumber && item.PhoneNumber.Number.ToString().Contains(term) )

                    || item.PhoneNumber.Operator?.ToLower().Contains(term) == true
                    || item.PhoneNumber.Type?.ToLower().Contains(term) == true

                    || item.PhoneNumberModel.Brand.Name?.ToLower().Contains(term) == true
                    || item.PhoneNumberModel.PhoneModel?.ToLower().Contains(term) == true
                    || item.PhoneNumberModel.PhoneSerial?.ToLower().Contains(term) == true

                    || item.Employee.Name?.ToLower().Contains(term) == true
                    || item.Employee.LastName?.ToLower().Contains(term) == true;
            })
        );

    void SortBy(string column)
    {
        if (currentSortColumn == column)
            asc = !asc;
        else
        {
            currentSortColumn = column;
            asc = true;
        }
    }

    IEnumerable<Phone_Number_User_Model> ApplySorting(IEnumerable<Phone_Number_User_Model> query)
    {
        return currentSortColumn switch
        {
            nameof(Phone_Number_User_Model.CreationDate) =>
                asc ? query.OrderBy(x => x.CreationDate)
                    : query.OrderByDescending(x => x.CreationDate),

            nameof(Phone_Number_User_Model.PhoneNumber.Operator) =>
                asc ? query.OrderBy(x => x.PhoneNumber.Operator)
                    : query.OrderByDescending(x => x.PhoneNumber.Operator),

            nameof(Phone_Number_User_Model.PhoneNumber.Number) =>
                    asc ? query.OrderBy(x => x.PhoneNumber.Number)
                        : query.OrderByDescending(x => x.PhoneNumber.Number),

            nameof(Phone_Number_User_Model.PhoneNumber.Type) =>
                asc ? query.OrderBy(x => x.PhoneNumber.Type)
                    : query.OrderByDescending(x => x.PhoneNumber.Type),

            nameof(Phone_Number_User_Model.PhoneNumberModel.Brand) =>
                asc ? query.OrderBy(x => x.PhoneNumberModel.Brand.Name)
                    : query.OrderByDescending(x => x.PhoneNumberModel.Brand.Name),

            nameof(Phone_Number_User_Model.PhoneNumberModel.PhoneModel) =>
                asc ? query.OrderBy(x => x.PhoneNumberModel.PhoneModel)
                    : query.OrderByDescending(x => x.PhoneNumberModel.PhoneModel),

            nameof(Phone_Number_User_Model.PhoneNumberModel.PhoneSerial) =>
                asc ? query.OrderBy(x => x.PhoneNumberModel.PhoneSerial)
                    : query.OrderByDescending(x => x.PhoneNumberModel.PhoneSerial),

            _ => query
        };
    }

    private void ClearSearch()
    {
        searchTerm = "";
    }


    private async Task DownloadXLSX()
    {
        using var workbook = new XLWorkbook();
        var ws = workbook.Worksheets.Add("Telefonos");

        var data = FilteredData.Where(x => x.IsActive).ToList();

        ws.Cell(1, 1).Value = "Fecha";
        ws.Cell(1, 2).Value = "Numero";
        ws.Cell(1, 3).Value = "Operador";
        ws.Cell(1, 4).Value = "Tipo";
        ws.Cell(1, 5).Value = "Marca";
        ws.Cell(1, 6).Value = "Modelo";
        ws.Cell(1, 7).Value = "Serie";
        ws.Cell(1, 8).Value = "Encargado";

        int row = 2;

        foreach (var i in data)
        {
            ws.Cell(row, 1).Value = i.CreationDate;
            ws.Cell(row, 2).Value = i.PhoneNumber.Number;
            ws.Cell(row, 3).Value = i.PhoneNumber.Operator;
            ws.Cell(row, 4).Value = i.PhoneNumber.Type;
            ws.Cell(row, 5).Value = i.PhoneNumberModel.Brand.Name;
            ws.Cell(row, 6).Value = i.PhoneNumberModel.PhoneModel;
            ws.Cell(row, 7).Value = i.PhoneNumberModel.PhoneSerial;
            ws.Cell(row, 8).Value = $"{i.Employee.LastName} {i.Employee.Name}";
            row++;
        }

        using var stream = new MemoryStream();
        workbook.SaveAs(stream);
        var content = Convert.ToBase64String(stream.ToArray());

        await JS.InvokeVoidAsync("downloadFile",
            $"Telefonos_{DateTime.Now:yyyyMMddHHmmss}.xlsx",
            content,
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
    }


    private async Task DownloadPDF(Phone_Number_User_Model e)
    {
        var pdfBytes = await pdfService.GeneratePDFPhone(e);
        string pdfBase64 = Convert.ToBase64String(pdfBytes);

        await JS.InvokeVoidAsync("downloadPDF",
            pdfBase64,
            $"Entrega Telefono {e.Employee.Name} {e.Employee.LastName}.pdf");
    }

}