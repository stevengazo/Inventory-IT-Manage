@page "/test"

@inject FileStorageService _fileStorage;
@inject IControllerServices<Audit> _auditService;
@inject IControllerServices<AuditImage> _auditImageService;


@if (ShowForm)
{
	<div class="border rounded p-1 shadow  mb-3 ">


		<EditForm Model="audit">
			<DataAnnotationsValidator />
			<ValidationSummary />
			<div class="form-group d-flex flex-row justify-content-between my-1">
				<label class="w-25" for="@nameof(audit.GeneralCondition)"></label>
				<InputSelect @bind-Value="audit.GeneralCondition" class="form-select w-75">
					@foreach (Condition i in Enum.GetValues(typeof(Condition)))
					{
						<option value="@i.ToString()">@i.ToString()</option>
					}
				</InputSelect>
			</div>
			<div class="form-group d-flex flex-row justify-content-between my-1">
				<label class="w-25">@nameof(audit.AuditDate)</label>
				<InputDate @bind-Value="audit.AuditDate" class="form-control w-75" />
			</div>
			<div class="form-group d-flex flex-row justify-content-between my-1">
				<label class="w-25">@nameof(audit.AuditorName)</label>
				<InputText @bind-Value="audit.AuditorName" class="form-control w-75" />
			</div>
			<div class="form-group d-flex flex-row justify-content-between my-1">
				<label class="w-25">@nameof(audit.Comments)</label>
				<InputText @bind-Value="audit.Comments" class="form-control w-75" />
			</div>
			<div class="form-group d-flex flex-row justify-content-between my-1">
				<label class="w-25">@nameof(audit.IsClean)</label>
				<InputCheckbox @bind-Value="audit.IsClean" class="l w-75" />
			</div>
			<div class="form-group d-flex flex-row justify-content-between my-1">
				<label class="w-25">@nameof(audit.IsOperational)</label>
				<InputCheckbox @bind-Value="audit.IsOperational" class=" w-75" />
			</div>
			<div class="form-group d-flex flex-row justify-content-between my-1">
				<label class="w-25">@nameof(audit.MissingItems)</label>
				<InputText @bind-Value="audit.MissingItems" class="form-control w-75" />
			</div>
			<div class="form-group d-flex flex-row justify-content-between my-1">
				<label class="w-25">@nameof(audit.RecommendedActions)</label>
				<InputText @bind-Value="audit.RecommendedActions" class="form-control w-75" />
			</div>
			<div>
				<label class="w-25">Carga de Archivos</label>
				<InputFile multiple accept="image/x-png,image/jpeg" OnChange="@OnChange" />
			</div>
			<!-- File List-->
			<div class="border shadow-sm rounded p-2 m-1">
				<h6 class="fw-bold mb-2">Archivos por Subir</h6>
				<label></label>
				<ul class="list-unstyled">
					@foreach (var file in files)
					{
						<li class="d-flex align-items-center justify-content-between p-1 border-bottom">
							<span>@file.Name</span>
							<button class="btn btn-danger btn-sm" @onclick="() => DeleteFile(file)">X</button>
						</li>
					}
				</ul>
			</div>

			<div class="d-flex flex-row justify-content-center align-items-center">
				<!-- Submit Button-->
				<div class="d-flex flex-row">
					<button @onclick="Add" class="btn btn-outline-success justify-content-center m-1">Guardar</button>
					<button class="btn btn-sm btn-outline-danger" @onclick="ChangeStateForm">Cerrar</button>
				</div>

				@if (IsLoading)
				{
					<label>Guardando...</label>
				}
			</div>
		</EditForm>

	</div>

}
else
{
	<div class="d-flex flex-row border justify-content-between rounded p-1 shadow">
		<h3>Reporte de Auditoria</h3>
		<button class="btn btn-sm btn-outline-info" @onclick="ChangeStateForm">Agregar Registro</button>
	</div>

}






@code {
	[Parameter]
	public string SerialNumber { get; set; } = string.Empty;
	[Parameter]
	public string DeviceId { get; set; } = string.Empty;
	[Parameter]
	public DeviceType Type { get; set; }

	private bool ShowForm = false;

	private bool IsLoading = false;
	private string ErrorMessage = string.Empty;
	private List<IBrowserFile> files = new();
	private Audit audit = new Audit();

	private void DeleteFile(IBrowserFile file)
	{
		files.Remove(file);
	}

	async Task OnChange(InputFileChangeEventArgs e)
	{
		foreach (var file in e.GetMultipleFiles())
		{
			if (file.Size > 20971520)
			{
				ErrorMessage = $"El archivo {file.Name} excede el tamaño máximo permitido de 10MB.\nEl archivo no será cargado.";
				continue;
			}
			else
			{
				files.Add(file);
			}
		}
	}

	async Task Add()
	{
		try
		{
			IsLoading = true;
			switch (Type)
			{
				case DeviceType.Computer:
					audit.ComputerModelID = int.Parse(DeviceId);
					break;
				case DeviceType.Peripheric:
					audit.PeripheralModelId = int.Parse(DeviceId);
					break;
				case DeviceType.Phone:
					audit.SmartPhoneModelId = int.Parse(DeviceId);
					break;
				default:
					break;
			}
			_auditService.Add(audit);

			await UploadFiles();
			await Clean();
		}
		catch (Exception w)
		{
			throw w;
		}
		finally
		{
			IsLoading = false;
		}
	}

	async Task UploadFiles()
	{
		try
		{
			await _fileStorage.GenerateDirectoryAsync(SerialNumber);
			foreach (var i in files)
			{
				AuditImage auditImage = new AuditImage();
				auditImage.FileName = i.Name;
				auditImage.AuditId = audit.AuditId;
				auditImage.ContentType = i.ContentType;
				switch (Type)
				{
					case DeviceType.Computer:
						await _fileStorage.GenerateDirectoryAsync($"{DeviceType.Computer}-{SerialNumber}");
						auditImage.PathFile = await _fileStorage.UploadFilesAsync($"{DeviceType.Computer}-{SerialNumber}", i);
						break;
					case DeviceType.Peripheric:
						await _fileStorage.GenerateDirectoryAsync($"{DeviceType.Peripheric}-{SerialNumber}");
						auditImage.PathFile = await _fileStorage.UploadFilesAsync($"{DeviceType.Peripheric}-{SerialNumber}", i);
						break;
					case DeviceType.Phone:
						await _fileStorage.GenerateDirectoryAsync($"{DeviceType.Phone}-{SerialNumber}");
						auditImage.PathFile = await _fileStorage.UploadFilesAsync($"{DeviceType.Phone}-{SerialNumber}", i);
						break;
					default:
						break;
				}
				_auditImageService.Add(auditImage);
			}
			files.Clear();
		}
		catch (Exception re)
		{

			throw re;
		}
	}

	async Task Clean()
	{
		audit = new Audit();	
		files.Clear();
		ChangeStateForm();
		StateHasChanged();

	}

	async Task ChangeStateForm()
	{
		ShowForm = !ShowForm;
	}
}
