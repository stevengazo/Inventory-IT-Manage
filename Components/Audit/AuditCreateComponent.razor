@page "/test"

@inject FileStorageService _fileStorage;
@inject IControllerServices<Audit> _auditService;
@inject IControllerServices<AuditImage> _auditImageService;

@if (ShowForm)
{
	<div class="card shadow-sm mb-4 border-0">
		<div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
			<h5 class="mb-0">📝 Registro de Auditoría</h5>
		</div>

		<div class="card-body">
			<EditForm Model="audit">
				<DataAnnotationsValidator />
				<ValidationSummary />

				<div class="row g-3">
					<div class="col-md-6">
						<label class="form-label fw-semibold">Condición General</label>
						<InputSelect @bind-Value="audit.GeneralCondition" class="form-select">
							@foreach (Condition i in Enum.GetValues(typeof(Condition)))
							{
								<option value="@i.ToString()">@i.ToString()</option>
							}
						</InputSelect>
					</div>

					<div class="col-md-6">
						<label class="form-label fw-semibold">Fecha de Auditoría</label>
						<InputDate @bind-Value="audit.AuditDate" class="form-control" />
					</div>

					<div class="col-md-6">
						<label class="form-label fw-semibold">Nombre del Auditor</label>
						<InputText @bind-Value="audit.AuditorName" class="form-control" />
					</div>

					<div class="col-md-6">
						<label class="form-label fw-semibold">Comentarios</label>
						<InputText @bind-Value="audit.Comments" class="form-control" />
					</div>

					<div class="col-md-6 d-flex align-items-center">
						<label class="form-label me-2 mb-0">¿Está Limpio?</label>
						<InputCheckbox @bind-Value="audit.IsClean" class="form-check-input" />
					</div>

					<div class="col-md-6 d-flex align-items-center">
						<label class="form-label me-2 mb-0">¿Está Operativo?</label>
						<InputCheckbox @bind-Value="audit.IsOperational" class="form-check-input" />
					</div>

					<div class="col-md-6">
						<label class="form-label fw-semibold">Ítems Faltantes</label>
						<InputText @bind-Value="audit.MissingItems" class="form-control" />
					</div>

					<div class="col-md-6">
						<label class="form-label fw-semibold">Acciones Recomendadas</label>
						<InputText @bind-Value="audit.RecommendedActions" class="form-control" />
					</div>

					<div class="col-12">
						<label class="form-label fw-semibold">📎 Carga de Archivos</label>
						<InputFile multiple accept="image/x-png,image/jpeg" OnChange="@OnChange" class="form-control" />
					</div>
				</div>

				@if (files?.Any() == true)
				{
					<div class="border shadow-sm rounded p-3 my-3 bg-light">
						<h6 class="fw-bold mb-3">Archivos por Subir</h6>
						<ul class="list-unstyled mb-0">
							@foreach (var file in files)
							{
								<li class="d-flex align-items-center justify-content-between border-bottom py-2">
									<span>@file.Name</span>
									<button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteFile(file)">Eliminar</button>
								</li>
							}
						</ul>
					</div>
				}

				<div class="d-flex justify-content-center mt-4">
					<button type="button" @onclick="Add" class="btn btn-success me-3">
						💾 Guardar
					</button>
					<button type="button" class="btn btn-outline-danger" @onclick="ChangeStateForm">
						❌ Cerrar
					</button>

					@if (IsLoading)
					{
						<span class="ms-3 text-muted">⏳ Guardando...</span>
					}
				</div>
			</EditForm>
		</div>
	</div>
}
else
{
	<div class="card shadow-sm border-0 p-3 d-flex flex-row justify-content-between align-items-center mb-3">
		<h5 class="mb-0">📄 Reporte de Auditoría</h5>
		<button class="btn btn-outline-primary btn-sm" @onclick="ChangeStateForm">
			➕ Agregar Registro
		</button>
	</div>
}






@code {
	[Parameter]
	public string SerialNumber { get; set; } = string.Empty;
	[Parameter]
	public string DeviceId { get; set; } = string.Empty;
	[Parameter]
	public DeviceType Type { get; set; }

	private bool ShowForm = false;

	private bool IsLoading = false;
	private string ErrorMessage = string.Empty;
	private List<IBrowserFile> files = new();
	private Audit audit = new Audit();

	private void DeleteFile(IBrowserFile file)
	{
		files.Remove(file);
	}

	async Task OnChange(InputFileChangeEventArgs e)
	{
		foreach (var file in e.GetMultipleFiles())
		{
			if (file.Size > 20971520)
			{
				ErrorMessage = $"El archivo {file.Name} excede el tamaño máximo permitido de 10MB.\nEl archivo no será cargado.";
				continue;
			}
			else
			{
				files.Add(file);
			}
		}
	}

	async Task Add()
	{
		try
		{
			IsLoading = true;
			switch (Type)
			{
				case DeviceType.Computer:
					audit.ComputerModelID = int.Parse(DeviceId);
					break;
				case DeviceType.Peripheric:
					audit.PeripheralModelId = int.Parse(DeviceId);
					break;
				case DeviceType.Phone:
					audit.SmartPhoneModelId = int.Parse(DeviceId);
					break;
				default:
					break;
			}
			_auditService.Add(audit);
			await UploadFiles();
		}
		catch (Exception w)
		{
			throw w;
		}
		finally
		{
			IsLoading = false;
			await Clean();
		}
	}

	async Task UploadFiles()
	{
		try
		{
			await _fileStorage.GenerateDirectoryAsync(SerialNumber);
			foreach (var i in files)
			{
				AuditImage auditImage = new AuditImage();
				auditImage.FileName = i.Name;
				auditImage.AuditId = audit.AuditId;
				auditImage.ContentType = i.ContentType;
				switch (Type)
				{
					case DeviceType.Computer:
						await _fileStorage.GenerateDirectoryAsync($"{DeviceType.Computer}-{SerialNumber}");
						auditImage.PathFile = await _fileStorage.UploadFilesAsync($"{DeviceType.Computer}-{SerialNumber}", i);
						break;
					case DeviceType.Peripheric:
						await _fileStorage.GenerateDirectoryAsync($"{DeviceType.Peripheric}-{SerialNumber}");
						auditImage.PathFile = await _fileStorage.UploadFilesAsync($"{DeviceType.Peripheric}-{SerialNumber}", i);
						break;
					case DeviceType.Phone:
						await _fileStorage.GenerateDirectoryAsync($"{DeviceType.Phone}-{SerialNumber}");
						auditImage.PathFile = await _fileStorage.UploadFilesAsync($"{DeviceType.Phone}-{SerialNumber}", i);
						break;
					default:
						break;
				}
				_auditImageService.Add(auditImage);
			}
		}
		catch (Exception re)
		{

			throw re;
		}
	}

	async Task Clean()
	{
		audit = new Audit();
		
		files.Clear();
		ChangeStateForm();
		StateHasChanged();

	}

	async Task ChangeStateForm()
	{
		ShowForm = !ShowForm;
	}
}
