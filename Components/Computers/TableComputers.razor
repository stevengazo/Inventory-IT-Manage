@inject PDFService pdfService
@inject IJSRuntime JS
@inject IControllerServices<ComputerModel> _ComputerService
@inject IHttpContextAccessor httpContextAccessor

<div class="shadow p-2 rounded">
        <input type="text"
               placeholder="Busqueda"
               @oninput="@(e => Search(e.Value?.ToString()))"
               class="form-control w-100" />
    

    @if (ActiveComputers.Any())
    {
        <div class="shadow-sm rounded-4 border table-responsive">

            <table class="table table-sm table-hover align-middle mb-0">

                <thead class="table-light text-nowrap sticky-top small text-uppercase">
                    <tr>
                        <th>Serie</th>
                        <th>Adquisición</th>
                        <th>Modelo</th>

                        <AuthorizeView Roles="Administrador,Lector">
                            <Authorized>
                                <th class="d-none d-md-table-cell">Costo</th>
                            </Authorized>
                        </AuthorizeView>

                        <th>Disco</th>
                        <th class="d-none d-md-table-cell">Capacidad</th>
                        <th class="d-none d-md-table-cell">RAM</th>
                        <th class="d-none d-md-table-cell">Memoria</th>
                        <th>Procesador</th>
                        <th class="d-none d-md-table-cell">Teclado</th>
                        <th>Encargado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var C in ActiveComputers)
                    {
                        <tr>

                            <td class="font-monospace small text-secondary">
                                @C.SerialNumber
                            </td>

                            <td class="small text-muted text-nowrap">
                                @C.AdquisitionDate.ToShortDateString()
                            </td>

                            <td class="fw-semibold text-nowrap">
                                @C.ModelName
                            </td>

                            <AuthorizeView Roles="Administrador,Lector">
                                <Authorized>
                                    <td class="d-none d-md-table-cell small text-muted">
                                        @(C.Cost != "0" && C.Cost != "1"
                                                                        ? $"$ {C.Cost}"
                                                                        : "No indicado")
                                    </td>
                                </Authorized>
                            </AuthorizeView>

                            <td>
                                <span class="badge @(C.HaveSSD ? "bg-success-subtle text-dark" : "bg-secondary-subtle text-dark")">
                                    @(C.HaveSSD ? "SSD" : "HDD")
                                </span>
                            </td>

                            <td class="d-none d-md-table-cell text-nowrap">
                                @C.SizeDisk GB
                            </td>

                            <td class="d-none d-md-table-cell">
                                <span class="badge bg-info-subtle text-dark">
                                    @C.RAMType
                                </span>
                            </td>

                            <td class="d-none d-md-table-cell text-nowrap">
                                @C.SizeRAM GB
                            </td>

                            <td class="text-nowrap">
                                @C.Processor
                            </td>

                            <td class="d-none d-md-table-cell">
                                @C.KeyboardLayout
                            </td>

                            <td class="text-capitalize">
                                @if (C.Employee != null && !C.Employee.Fired)
                                {
                                    <span class="fw-semibold">
                                        @($"{C.Employee.Name} {C.Employee.LastName}")
                                    </span>
                                }
                                else if (C.Employee != null && C.Employee.Fired)
                                {
                                    <span class="text-danger small">
                                        @($"{C.Employee.Name} {C.Employee.LastName}") (Despedido)
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted small">
                                        Sin asignar
                                    </span>
                                }
                            </td>

                            <td class="text-center">
                                <div class="d-inline-flex gap-1">

                                    @if (C.Employee != null)
                                    {
                                        <button @onclick="() => DownloadPDF(C)"
                                                class="btn btn-sm btn-outline-warning">
                                            <span class="oi oi-document"></span>
                                        </button>
                                    }

                                    <a href="/computers/@C.ComputerModelID"
                                       class="btn btn-sm btn-outline-info">
                                        <span class="oi oi-eye"></span>
                                    </a>

                                    <AuthorizeView Roles="Administrador">
                                        <Authorized>

                                            <a href="/computers/edit/@C.ComputerModelID"
                                               class="btn btn-sm btn-outline-success">
                                                <span class="oi oi-pencil"></span>
                                            </a>

                                            <button @onclick="() => Disable(C)"
                                                    class="btn btn-sm btn-outline-danger">
                                                <span class="oi oi-delete"></span>
                                            </button>

                                        </Authorized>
                                    </AuthorizeView>

                                </div>
                            </td>

                        </tr>
                    }
                </tbody>

            </table>

        </div>
    }

    @if (InactiveComputers.Any())
    {
        <hr />
        <h3>Equipos Desactivados</h3>

        <div class="shadow-sm rounded-4 border table-responsive">

            <table class="table table-sm table-hover align-middle mb-0">

                <thead class="table-light text-nowrap sticky-top small text-uppercase">
                    <tr>
                        <th>Serie</th>
                        <th>Adquisición</th>
                        <th>Modelo</th>

                        <AuthorizeView Roles="Administrador,Lector">
                            <Authorized>
                                <th class="d-none d-md-table-cell">Costo</th>
                            </Authorized>
                        </AuthorizeView>

                        <th>Disco</th>
                        <th class="d-none d-md-table-cell">Capacidad</th>
                        <th class="d-none d-md-table-cell">RAM</th>
                        <th class="d-none d-md-table-cell">Memoria</th>
                        <th>Procesador</th>
                        <th class="d-none d-md-table-cell">Teclado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var C in InactiveComputers)
                    {
                        <tr class="text-danger">

                            <td class="font-monospace small text-secondary">
                                @C.SerialNumber
                            </td>

                            <td class="small text-muted text-nowrap">
                                @C.AdquisitionDate.ToShortDateString()
                            </td>

                            <td class="fw-semibold text-nowrap">
                                @C.ModelName
                            </td>

                            <AuthorizeView Roles="Administrador,Lector">
                                <Authorized>
                                    <td class="d-none d-md-table-cell small text-muted">
                                        @(C.Cost != "0" && C.Cost != "1"
                                                                        ? $"$ {C.Cost}"
                                                                        : "No indicado")
                                    </td>
                                </Authorized>
                            </AuthorizeView>

                            <td>
                                <span class="badge @(C.HaveSSD ? "bg-success-subtle text-dark" : "bg-secondary-subtle text-dark")">
                                    @(C.HaveSSD ? "SSD" : "HDD")
                                </span>
                            </td>

                            <td class="d-none d-md-table-cell text-nowrap">
                                @C.SizeDisk GB
                            </td>

                            <td class="d-none d-md-table-cell">
                                <span class="badge bg-info-subtle text-dark">
                                    @C.RAMType
                                </span>
                            </td>

                            <td class="d-none d-md-table-cell text-nowrap">
                                @C.SizeRAM GB
                            </td>

                            <td class="text-nowrap">
                                @C.Processor
                            </td>

                            <td class="d-none d-md-table-cell">
                                @C.KeyboardLayout
                            </td>

                          

                            <td class="text-center">
                                <div class="d-inline-flex gap-1">

                        

                                    <a href="/computers/@C.ComputerModelID"
                                       class="btn btn-sm btn-outline-info">
                                        <span class="oi oi-eye"></span>
                                    </a>

                                    <AuthorizeView Roles="Administrador">
                                        <Authorized>

                                            <a href="/computers/edit/@C.ComputerModelID"
                                               class="btn btn-sm btn-outline-success">
                                                <span class="oi oi-pencil"></span>
                                            </a>

                                         

                                        </Authorized>
                                    </AuthorizeView>

                                </div>
                            </td>

                        </tr>
                    }
                </tbody>

            </table>

        </div>
    }
</div>

@code {

    [Parameter]
    public List<ComputerModel> Computers { get; set; } = new();

    private List<ComputerModel> computerstemp = new();

    private IEnumerable<ComputerModel> ActiveComputers =>
        computerstemp?.Where(x => x.IsActive) ?? Enumerable.Empty<ComputerModel>();

    private IEnumerable<ComputerModel> InactiveComputers =>
        computerstemp?.Where(x => !x.IsActive) ?? Enumerable.Empty<ComputerModel>();

    protected override void OnParametersSet()
    {
        computerstemp = Computers.ToList();
    }

    private void Disable(ComputerModel e)
    {
        _ComputerService.Delete(e);
        Computers.Remove(e);
        computerstemp.Remove(e);
    }

    private void Search(string value = "")
    {
        if (!string.IsNullOrWhiteSpace(value))
        {
            computerstemp = Computers
                .Where(i =>
                    i.SerialNumber.ToLower().Contains(value.ToLower()) ||
                    i.ModelName.ToLower().Contains(value.ToLower()))
                .ToList();
        }
        else
        {
            computerstemp = Computers.ToList();
        }
    }

    private async Task DownloadPDF(ComputerModel e)
    {
        var pdfBytes = await pdfService.GeneratePDFComputer(e);
        string pdfBase64 = Convert.ToBase64String(pdfBytes);

        await JS.InvokeVoidAsync("downloadPDF",
            pdfBase64,
            $"Entrega Computadora {e.Employee?.Name} {e.Employee?.LastName} {DateTime.Now:HHmmss}.pdf");
    }
}