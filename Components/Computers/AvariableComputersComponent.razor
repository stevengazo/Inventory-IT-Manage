@inject IControllerServices<ComputerModel> _ComputerService;

<div>
    <h4 class="text-center">Computadoras Disponibles</h4>

    <div class="d-flex flex-wrap gap-2 justify-content-center">
        @foreach (var i in computerModels)
        {
            <div class="border rounded p-3 d-flex flex-column flex-md-row w-100 bg-light align-items-center gap-3">
                <div class="d-flex flex-column flex-md-row gap-2 gap-md-1 w-100 align-items-center  ">
                    <label class="fw-bold">Modelo:</label>
                    <h6 class="mb-0">@i.ModelName</h6>
                </div>
                <div class="d-flex flex-column flex-md-row gap-2 gap-md-1 w-100 align-items-center  ">
                    <label class="fw-bold">Procesador:</label>
                    <label class="mb-0">@i.Processor</label>
                </div>
                <div class="d-flex flex-column flex-md-row gap-2 gap-md-1 w-100 align-items-center  ">
                    <label class="fw-bold">RAM:</label>
                    <label class="mb-0">@i.SizeRAM.ToString()</label>
                </div>
                <div class="d-flex flex-column flex-md-row gap-2 gap-md-1 w-100 align-items-center  ">
                    <a href="/computers/@i.ComputerModelID" class="bg-secondary rounded p-2 text-white d-inline-block">
                        <span class="oi oi-eye" aria-hidden="true"></span> Ver más
                    </a>
                </div>
            </div>

        }
    </div>
</div>

<div class="mt-4">
    <h4 class="text-center text-danger">Computadoras Desactivadas</h4>

    <div class="d-flex flex-wrap gap-2 justify-content-center">
        @foreach (var i in computersDisable)
        {
            <div class="border rounded p-3 d-flex flex-column flex-md-row w-100 bg-light align-items-center gap-3">
                <div class="d-flex flex-column flex-md-row gap-2 gap-md-1 w-100 align-items-center  ">
                    <label class="fw-bold">Modelo:</label>
                    <h6 class="mb-0">@i.ModelName</h6>
                </div>
                <div class="d-flex flex-column flex-md-row gap-2 gap-md-1 w-100 align-items-center  ">
                    <label class="fw-bold">Procesador:</label>
                    <label class="mb-0">@i.Processor</label>
                </div>
                <div class="d-flex flex-column flex-md-row gap-2 gap-md-1 w-100 align-items-center  ">
                    <label class="fw-bold">RAM:</label>
                    <label class="mb-0">@i.SizeRAM.ToString()</label>
                </div>
                <div class="d-flex flex-column flex-md-row gap-2 gap-md-1 w-100 align-items-center  ">
                    <a href="/computers/@i.ComputerModelID" class="bg-secondary rounded p-2 text-white d-inline-block">
                        <span class="oi oi-eye" aria-hidden="true"></span> Ver más
                    </a>
                </div>
            </div>
        }
    </div>
</div>

@code {
    List<ComputerModel> computerModels = new();
    List<ComputerModel> computersDisable = new();

    protected override async Task OnInitializedAsync()
    {
        computerModels = _ComputerService.GetAll()
            .Where(i => i.EmployeeId == null && i.IsActive)
            .OrderBy(i => i.ModelName)
            .ToList();

        computersDisable = _ComputerService.GetAll()
            .Where(i => i.EmployeeId == null && !i.IsActive)
            .OrderBy( i=>i.ModelName)
            .ToList();

        await base.OnInitializedAsync();
    }
}
