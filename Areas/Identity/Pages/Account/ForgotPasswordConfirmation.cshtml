@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Forgot password confirmation";
}

<style>
	body {
		margin: 0;
		padding: 0;
		font-family: 'Segoe UI', sans-serif;
		background: linear-gradient(114deg, rgba(51, 182, 196, 1) 0%, rgba(15, 168, 38, 1) 100%);
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
	}

	header {
		display: none !important;
		position: absolute !important;
		top: 0 !important;
		left: 0 !important;
		width: 100% !important; /* Asegura que ocupe todo el ancho */
		justify-content: space-between !important;
		align-items: center !important;
		padding: 0 2rem; /* Un poco de espacio a los lados */
	}

		header .nav-links a {
			margin-left: 1.5rem;
			color: #222;
			text-decoration: none;
			font-weight: 500;
		}

			header .nav-links a:hover {
				color: #0fa826;
			}

	nav {
		background: transparent !important;
	}

	.login-container {
		flex-grow: 1;
		display: flex;
		justify-content: center;
		align-items: center;
		padding: 2rem;
	}

	.login-card {
		background: white;
		border-radius: 20px;
		padding: 2rem;
		box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
		width: 100%;
		max-width: 400px;
	}

	.form-floating label {
		color: #555;
	}

	.btn-primary {
		background-color: #33b6c4;
		border: none;
	}

		.btn-primary:hover {
			background-color: #1ea6b2;
		}

	.form-check-input {
		margin-right: 0.5rem;
	}

	a {
		color: #1ea6b2;
		text-decoration: none;
	}

		a:hover {
			text-decoration: underline;
		}

	footer {
		display: none;
		color: #f8f9fa;
		position: absolute;
		bottom: 0;
	}

</style>

<div class="login-container">
	<div class="login-card">
		<h1 class="text-center">@ViewData["Title"]</h1>
		<p class="text-center">
			Por favor, revisa tu correo electrónico para restablecer tu contraseña.
		</p>
	</div>
</div>
