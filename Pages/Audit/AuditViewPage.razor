@page "/Audit/{id}"

@inject FileStorageService _fileStorage;
@inject IControllerServices<Audit> _auditService;
@inject IControllerServices<AuditImage> _auditImageService;

<div class="container my-4">
    <div class="card shadow border-0">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">📝 Información de Auditoría</h4>
        </div>
        <div class="card-body p-4">
            <table class="table table-bordered mb-0">
                <tbody>
                    <tr>
                        <th class="bg-light w-25">Fecha de Auditoría</th>
                        <td>@audit.AuditDate.ToString("dd/MM/yyyy")</td>
                    </tr>
                    <tr>
                        <th class="bg-light">Nombre del Auditor</th>
                        <td>@audit.AuditorName</td>
                    </tr>
                    <tr>
                        <th class="bg-light">Condición General</th>
                        <td>@audit.GeneralCondition</td>
                    </tr>
                    <tr>
                        <th class="bg-light">¿Está Limpio?</th>
                        <td>@(audit.IsClean ? "✅ Sí" : "❌ No")</td>
                    </tr>
                    <tr>
                        <th class="bg-light">¿Está Operativo?</th>
                        <td>@(audit.IsOperational ? "✅ Sí" : "❌ No")</td>
                    </tr>
                    <tr>
                        <th class="bg-light">Comentarios</th>
                        <td>@audit.Comments</td>
                    </tr>
                    <tr>
                        <th class="bg-light">Acciones Recomendadas</th>
                        <td>@audit.RecommendedActions</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-4">
        <h5 class="text-secondary mb-3">📷 Imágenes de Auditoría</h5>
        <AuditImageUploadComponent AuditId="@audit.AuditId.ToString()" SerialNumber="serial" Type="deviceType"  />
        <div class="d-flex flex-wrap gap-3">
            @foreach (var i in auditImages)
            {
                <AuditImageItemComponent item="@i" />
            }
        </div>
    </div>
</div>



@code {
    [Parameter]
    public string id { get; set; }

    Audit audit = new();

    List<AuditImage> auditImages = new();

    string serial = "";
    DeviceType deviceType;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(id) && int.TryParse(id, out int idInt))
        {
            audit = _auditService.GetById(idInt);

            if (audit.Computer != null)
            {
                deviceType = DeviceType.Computer;
                serial = audit.Computer.SerialNumber;
            }
            else if (audit.Peripheral != null)
            {
                deviceType = DeviceType.Peripheric;
                serial = audit.Peripheral.SerialNumber;
            }
            else if (audit.SmartPhone != null)
            {
                deviceType = DeviceType.Phone;
                serial = audit.SmartPhone.PhoneSerial;
            }

            auditImages = _auditImageService.Search(e => e.AuditId == audit.AuditId);
        }

        await base.OnInitializedAsync();
    }
}
